 "dialogue": [
  {
   "speaker": "Andy",
   "en": "Ow!",
   "zh": "啊哟！",
   "audio": {
    "file": "media/L099.mp4",
    "start": 7,
    "end": 9.2
   }
  },
  {
   "speaker": "Lucy",
   "en": "What's the matter, Andy?",
   "zh": "怎么了，安迪？",
   "audio": {
    "file": "media/L099.mp4",
    "start": 9.2,
    "end": 11.3
   }
  },
  {
   "speaker": "Andy",
   "en": "I slipped and fell downstairs.",
   "zh": "我滑了一跤，从楼梯上摔下来了。",
   "audio": {
    "file": "media/L099.mp4",
    "start": 11.3,
    "end": 14.6
   }
  },
  {
   "speaker": "Lucy",
   "en": "Have you hurt yourself?",
   "zh": "你摔伤了没有？",
   "audio": {
    "file": "media/L099.mp4",
    "start": 14.6,
    "end": 16.6
   }
  },
  {
   "speaker": "Andy",
   "en": "Yes, I have.",
   "zh": "是啊，摔伤了。",
   "audio": {
    "file": "media/L099.mp4",
    "start": 16.6,
    "end": 18.3
   }
  },
  {
   "speaker": "Andy",
   "en": "I think that I've hurt my back.",
   "zh": "我想我把背摔坏了。",
   "audio": {
    "file": "media/L099.mp4",
    "start": 18.3,
    "end": 21.6
   }
  },
  {
   "speaker": "Lucy",
   "en": "Try and stand up.",
   "zh": "试试站起来。",
   "audio": {
    "file": "media/L099.mp4",
    "start": 21.6,
    "end": 24.2
   }
  },
  {
   "speaker": "Lucy",
   "en": "Can you stand up?",
   "zh": "你能站起来吗？",
   "audio": {
    "file": "media/L099.mp4",
    "start": 24.2,
    "end": 26.4
   }
  },
  {
   "speaker": "Lucy",
   "en": "Here. Let me help you.",
   "zh": "来，让我帮你。",
   "audio": {
    "file": "media/L099.mp4",
    "start": 26.4,
    "end": 28.6
   }
  },
  {
   "speaker": "Andy",
   "en": "I'm sorry, Lucy.",
   "zh": "对不起，露西。",
   "audio": {
    "file": "media/L099.mp4",
    "start": 29.1,
    "end": 31.1
   }
  },
  {
   "speaker": "Andy",
   "en": "I'm afraid that I can't get up.",
   "zh": "恐怕我站不起来。",
   "audio": {
    "file": "media/L099.mp4",
    "start": 31.1,
    "end": 34
   }
  },
  {
   "speaker": "Lucy",
   "en": "I think that the doctor had better see you.",
   "zh": "我想最好请医生来给你看一下。",
   "audio": {
    "file": "media/L099.mp4",
    "start": 35,
    "end": 38.1
   }
  },
  {
   "speaker": "Lucy",
   "en": "I'll phone Dr. Carter.",
   "zh": "我去给卡特医生打电话。",
   "audio": {
    "file": "media/L099.mp4",
    "start": 38.1,
    "end": 41.6
   }
  },
  {
   "speaker": "Lucy",
   "en": "The doctor says that he will come at once.",
   "zh": "医生说他马上就来。",
   "audio": {
    "file": "media/L099.mp4",
    "start": 41.6,
    "end": 44.9
   }
  },
  {
   "speaker": "Lucy",
   "en": "I'm sure that you need an X-ray, Andy.",
