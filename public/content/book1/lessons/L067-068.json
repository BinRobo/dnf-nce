 "dialogue": [
  {
   "speaker": "Mrs. Johnson",
   "en": "Hello.",
   "zh": "您好。",
   "audio": {
    "file": "media/L067.mp4",
    "start": 6.9,
    "end": 9.1
   }
  },
  {
   "speaker": "Mrs. Johnson",
   "en": "Were you at the butcher's?",
   "zh": "刚才您在肉店里吗？",
   "audio": {
    "file": "media/L067.mp4",
    "start": 9.1,
    "end": 11.5
   }
  },
  {
   "speaker": "Mrs. Williams",
   "en": "Yes, I was.",
   "zh": "是的，我在肉店里。",
   "audio": {
    "file": "media/L067.mp4",
    "start": 11.5,
    "end": 13.3
   }
  },
  {
   "speaker": "Mrs. Williams",
   "en": "Were you at the butcher's, too?",
   "zh": "您也在肉店里吗？",
   "audio": {
    "file": "media/L067.mp4",
    "start": 13.3,
    "end": 15.8
   }
  },
  {
   "speaker": "Mrs. Johnson",
   "en": "No, I wasn't.",
   "zh": "不，我不是。",
   "audio": {
    "file": "media/L067.mp4",
    "start": 15.8,
    "end": 17.8
   }
  },
  {
   "speaker": "Mrs. Johnson",
   "en": "I was at the greengrocer's.",
   "zh": "我在蔬菜水果店里。",
   "audio": {
    "file": "media/L067.mp4",
    "start": 17.8,
    "end": 20.5
   }
  },
  {
   "speaker": "Mrs. Johnson",
   "en": "How's Jimmy today?",
   "zh": "吉米今天怎么样？",
   "audio": {
    "file": "media/L067.mp4",
    "start": 20.5,
    "end": 23.2
   }
  },
  {
   "speaker": "Mrs. Williams",
   "en": "He's very well, thank you.",
   "zh": "他很好，谢谢您。",
   "audio": {
    "file": "media/L067.mp4",
    "start": 23.2,
    "end": 25.8
   }
  },
  {
   "speaker": "Mrs. Johnson",
   "en": "Was he absent from school last week?",
   "zh": "上星期他没上学吧？",
   "audio": {
    "file": "media/L067.mp4",
    "start": 25.8,
    "end": 29.4
   }
  },
  {
   "speaker": "Mrs. Williams",
   "en": "Yes, he was.",
   "zh": "是的，他没上学。",
   "audio": {
    "file": "media/L067.mp4",
    "start": 29.4,
    "end": 31.6
   }
  },
  {
   "speaker": "Mrs. Williams",
   "en": "He was absent on Monday, Tuesday, Wednesday and Thursday.",
   "zh": "他星期一、星期二、星期三和星期四没去上学。",
   "audio": {
    "file": "media/L067.mp4",
    "start": 31.6,
    "end": 37.8
   }
  },
  {
   "speaker": "Mrs. Williams",
   "en": "How are you all keeping?",
   "zh": "你们身体都好吗？",
   "audio": {
    "file": "media/L067.mp4",
    "start": 37.8,
    "end": 39.9
   }
  },
  {
   "speaker": "Mrs. Johnson",
   "en": "Very well, thank you.",
   "zh": "很好，谢谢您。",
   "audio": {
    "file": "media/L067.mp4",
    "start": 39.9,
    "end": 42
   }
  },
  {
   "speaker": "Mrs. Johnson",
   "en": "We're going to spend three days in the country.",
   "zh": "我们打算到乡下去三天。",
   "audio": {
    "file": "media/L067.mp4",
    "start": 42,
    "end": 45
   }
  },
  {
   "speaker": "Mrs. Johnson",
   "en": "We're going to stay at my mother's for the weekend.",
   "zh": "在我母亲家度周末。",
   "audio": {
    "file": "media/L067.mp4",
    "start": 45,
    "end": 48.8
   }
  },
  {
   "speaker": "Mrs. Williams",
   "en": "Friday, Saturday and Sunday in the country!",
   "zh": "星期五、星期六和星期日在乡下过！",
   "audio": {
    "file": "media/L067.mp4",
    "start": 48.8,
    "end": 52.5
   }
  },
  {
   "speaker": "Mrs. Williams",
   "en": "Aren't you lucky!",
   "zh": "你们真幸运啊！",
   "audio": {
    "file": "media/L067.mp4",
    "start": 52.5,
    "end": 55.4
   }
  }
