    "file": "media/L123.mp4",
    "start": 43.6,
    "end": 46.7
   }
  },
  {
   "speaker": "Mike",
   "en": "That's right.",
   "zh": "对。",
   "audio": {
    "file": "media/L123.mp4",
    "start": 47.3,
    "end": 49.6
   }
  },
  {
   "speaker": "Scott",
   "en": "Who's this?",
   "zh": "这是谁？",
   "audio": {
    "file": "media/L123.mp4",
    "start": 49.6,
    "end": 52
   }
  },
  {
   "speaker": "Mike",
   "en": "Guess!",
   "zh": "你猜！",
   "audio": {
    "file": "media/L123.mp4",
    "start": 52,
    "end": 54
   }
  },
  {
   "speaker": "Scott",
   "en": "It's not you, is it?",
   "zh": "这不是你，对吗？",
   "audio": {
    "file": "media/L123.mp4",
