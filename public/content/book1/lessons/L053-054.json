 "dialogue": [
  {
   "speaker": "Hans",
   "en": "Where do you come from?",
   "zh": "你是哪国人？",
   "audio": {
    "file": "media/L053.mp4",
    "start": 7,
    "end": 11
   }
  },
  {
   "speaker": "Jim",
   "en": "I come from England.",
   "zh": "我是英国人。",
   "audio": {
    "file": "media/L053.mp4",
    "start": 11,
    "end": 14.8
   }
  },
  {
   "speaker": "Hans",
   "en": "What's the climate like in your country?",
   "zh": "你们国家的气候怎么样？",
   "audio": {
    "file": "media/L053.mp4",
    "start": 14.8,
    "end": 19.2
   }
  },
  {
   "speaker": "Jim",
   "en": "It's mild, but it's not always pleasant.",
   "zh": "气候温和，但也不总是宜人的。",
   "audio": {
    "file": "media/L053.mp4",
    "start": 19.2,
    "end": 24
   }
  },
  {
   "speaker": "Jim",
   "en": "The weather's often cold in the North and windy in the East.",
   "zh": "北部的天气常常寒冷，东部则常常刮风。",
   "audio": {
    "file": "media/L053.mp4",
    "start": 24,
    "end": 29.9
   }
  },
  {
   "speaker": "Jim",
   "en": "It's often wet in the West and sometimes warm in the South.",
   "zh": "西部常下雨，南部有时则很暖和。",
   "audio": {
    "file": "media/L053.mp4",
    "start": 29.9,
    "end": 37
   }
  },
  {
   "speaker": "Hans",
   "en": "Which seasons do you like best?",
   "zh": "你最喜欢哪些季节？",
   "audio": {
    "file": "media/L053.mp4",
    "start": 37,
    "end": 40.8
   }
  },
  {
   "speaker": "Jim",
   "en": "I like spring and summer.",
   "zh": "我最喜欢春季和夏季。",
   "audio": {
    "file": "media/L053.mp4",
    "start": 40.8,
    "end": 43.9
   }
  },
  {
   "speaker": "Jim",
   "en": "The days are long and the nights are short.",
   "zh": "因为此时白天长而夜晚短，",
   "audio": {
    "file": "media/L053.mp4",
    "start": 43.9,
    "end": 48
   }
  },
  {
   "speaker": "Jim",
   "en": "The sun rises early and sets late.",
   "zh": "太阳升得早而落得晚。",
   "audio": {
    "file": "media/L053.mp4",
    "start": 48,
    "end": 53.1
   }
  },
  {
   "speaker": "Jim",
   "en": "I don't like autumn and winter.",
   "zh": "我不喜欢秋季和冬季。",
   "audio": {
    "file": "media/L053.mp4",
    "start": 53.1,
    "end": 56.5
   }
  },
  {
   "speaker": "Jim",
   "en": "The days are short and the nights are long.",
   "zh": "因为此时白天短而夜晚长，",
   "audio": {
    "file": "media/L053.mp4",
    "start": 56.5,
    "end": 60.9
   }
  },
  {
   "speaker": "Jim",
   "en": "The sun rises late and sets early.",
   "zh": "太阳升得迟而落得早。",
   "audio": {
    "file": "media/L053.mp4",
    "start": 60.9,
    "end": 65.3
   }
  },
  {
   "speaker": "Jim",
   "en": "Our climate is not very good,",
   "zh": "虽然我们国家的气候并不很好，",
   "audio": {
    "file": "media/L053.mp4",
    "start": 65.3,
    "end": 68.4
   }
  },
  {
   "speaker": "Jim",
   "en": "but it's certainly interesting.",
   "zh": "但又确实很有意思。",
   "audio": {
    "file": "media/L053.mp4",
    "start": 68.4,
    "end": 71.3
   }
  },
  {
   "speaker": "Jim",
   "en": "It's our favourite subject of conversation.",
   "zh": "天气是我们最喜欢谈论的话题。",
   "audio": {
    "file": "media/L053.mp4",
    "start": 71.3,
    "end": 76
   }
  }
 ],
