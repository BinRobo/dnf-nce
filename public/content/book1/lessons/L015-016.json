    "end": 37
   }
  },
  {
   "speaker": "Girls",
   "en": "No, they aren't.",
   "zh": "不，不是。",
   "audio": {
    "file": "media/L015.mp4",
    "start": 37,
    "end": 40.4
   }
  },
  {
   "speaker": "Girls",
   "en": "Our cases are brown.",
   "zh": "我们的箱子是棕色的。",
   "audio": {
    "file": "media/L015.mp4",
    "start": 40.4,
    "end": 44
   }
  },
  {
   "speaker": "Girls",
   "en": "Here they are.",
   "zh": "在这儿呢。",
   "audio": {
    "file": "media/L015.mp4",
    "start": 44,
    "end": 46.8
   }
  },
  {
   "speaker": "Customs officer",
   "en": "Are you tourists?",
   "zh": "你们是来旅游的吗？",
   "audio": {
    "file": "media/L015.mp4",
