    "end": 62.7
   }
  },
  {
   "speaker": "Mrs. Williams",
   "en": "He's in bed, doctor.",
   "zh": "他在床上呢，医生。",
   "audio": {
    "file": "media/L063.mp4",
    "start": 62.7,
    "end": 65.4
   }
  },
  {
   "speaker": "Mrs. Williams",
   "en": "Can you see him please?",
   "zh": "您能看看他吗？",
   "audio": {
    "file": "media/L063.mp4",
    "start": 65.4,
    "end": 67.8
   }
  },
  {
