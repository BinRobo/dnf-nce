 "dialogue": [
  {
   "speaker": "Customer",
   "en": "I bought two expensive dictionaries here half an hour ago, but I forgot to take them with me.",
   "zh": "半小时以前我在这里买了两本很贵的辞典，但是我忘了拿走。",
   "audio": {
    "file": "media/L121.mp4",
    "start": 7.7,
    "end": 16.4
   }
  },
  {
   "speaker": "Manager",
   "en": "Who served you, sir?",
   "zh": "是谁接待您的，先生？",
   "audio": {
    "file": "media/L121.mp4",
    "start": 16.4,
    "end": 19.3
   }
  },
  {
   "speaker": "Customer",
   "en": "The lady who is standing behind the counter.",
   "zh": "站在柜台后面的那位女士。",
   "audio": {
    "file": "media/L121.mp4",
    "start": 19.3,
    "end": 23.3
   }
  },
  {
   "speaker": "Manager",
   "en": "Which books did you buy?",
   "zh": "您买的是两本什么书？",
   "audio": {
    "file": "media/L121.mp4",
    "start": 23.3,
    "end": 26.8
   }
  },
  {
   "speaker": "Customer",
   "en": "The books which are on the counter.",
   "zh": "就是柜台上的那两本。",
   "audio": {
    "file": "media/L121.mp4",
    "start": 26.8,
    "end": 30.6
   }
  },
  {
   "speaker": "Manager",
   "en": "Did you serve this gentleman half an hour ago, Caroline?",
   "zh": "卡罗琳，半小时前你接待过这位先生吗？",
   "audio": {
    "file": "media/L121.mp4",
    "start": 30.6,
    "end": 35.4
   }
  },
  {
   "speaker": "Manager",
   "en": "He says he's the man who bought these books.",
   "zh": "他说他就是买这两本书的人。",
   "audio": {
    "file": "media/L121.mp4",
    "start": 35.4,
    "end": 39.9
   }
  },
  {
   "speaker": "Caroline",
   "en": "I can't remember.",
   "zh": "我记不起来了。",
   "audio": {
    "file": "media/L121.mp4",
    "start": 39.9,
    "end": 42.4
   }
  },
  {
   "speaker": "Caroline",
   "en": "The man who I served was wearing a hat.",
   "zh": "我接待的那个人戴着一顶帽子。",
   "audio": {
    "file": "media/L121.mp4",
    "start": 42.4,
    "end": 46
   }
  },
  {
   "speaker": "Manager",
   "en": "Have you got a hat, sir?",
   "zh": "先生，您有帽子吗？",
   "audio": {
    "file": "media/L121.mp4",
    "start": 46,
    "end": 48.8
   }
  },
  {
   "speaker": "Customer",
   "en": "Yes, I have.",
   "zh": "有的，我有帽子。",
   "audio": {
    "file": "media/L121.mp4",
    "start": 48.8,
    "end": 51.6
   }
  },
  {
   "speaker": "Manager",
   "en": "Would you put it on, please?",
   "zh": "请您把帽子戴上好吗？",
   "audio": {
    "file": "media/L121.mp4",
    "start": 51.6,
    "end": 54.8
   }
  },
  {
   "speaker": "Customer",
   "en": "All right.",
   "zh": "好吧。",
   "audio": {
    "file": "media/L121.mp4",
    "start": 54.8,
