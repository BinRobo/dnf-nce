    "end": 50.5
   }
  },
  {
   "speaker": "Attendant",
   "en": "D. N. Hall, 83, Bridge Street.",
   "zh": "D·N·霍尔，大桥街 83 号。",
   "audio": {
    "file": "media/L097.mp4",
    "start": 50.5,
    "end": 56.9
   }
  },
  {
   "speaker": "Attendant",
   "en": "Three pounds fifty pence, please.",
   "zh": "请付 3 英镑 50 便士。",
   "audio": {
    "file": "media/L097.mp4",
