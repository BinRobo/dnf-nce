    "end": 43.5
   }
  },
  {
   "speaker": "Mr. Hall",
   "en": "David Hall, 83, Bridge Street.",
   "zh": "大卫·霍尔，大桥街 83 号。",
   "audio": {
    "file": "media/L097.mp4",
    "start": 43.5,
    "end": 48.7
   }
  },
  {
   "speaker": "Attendant",
   "en": "That's right.",
   "zh": "那就对了。",
