 "dialogue": [
  {
   "speaker": "Mr. Hall",
   "en": "I left a suitcase on the train to London the other day.",
   "zh": "几天前我把一只手提箱忘在开往伦敦的火车上了。",
   "audio": {
    "file": "media/L097.mp4",
    "start": 7,
    "end": 12.6
   }
  },
  {
   "speaker": "Attendant",
   "en": "Can you describe it, sir?",
   "zh": "先生，您能描述一下它是什么样子的吗？",
   "audio": {
    "file": "media/L097.mp4",
    "start": 12.6,
    "end": 15
   }
  },
  {
   "speaker": "Mr. Hall",
   "en": "It's a small blue case and it's got a zip.",
   "zh": "是只蓝色的小箱子，上面有拉链。",
   "audio": {
    "file": "media/L097.mp4",
    "start": 15,
    "end": 19.8
   }
  },
  {
   "speaker": "Mr. Hall",
   "en": "There's a label on the handle with my name and address on it.",
   "zh": "箱把上有一标签，上面写着我的姓名和住址。",
   "audio": {
    "file": "media/L097.mp4",
    "start": 19.8,
    "end": 26.1
   }
  },
  {
   "speaker": "Attendant",
   "en": "Is this case yours?",
   "zh": "这箱子是您的吗？",
   "audio": {
    "file": "media/L097.mp4",
    "start": 26.1,
    "end": 29.1
   }
  },
  {
   "speaker": "Mr. Hall",
   "en": "No, that's not mine.",
   "zh": "不，那不是我的。",
   "audio": {
    "file": "media/L097.mp4",
    "start": 29.1,
    "end": 31.6
   }
  },
  {
   "speaker": "Attendant",
   "en": "What about this one?",
   "zh": "这只是不是？",
   "audio": {
    "file": "media/L097.mp4",
    "start": 31.6,
    "end": 34.3
   }
  },
  {
   "speaker": "Attendant",
   "en": "This one's got a label.",
   "zh": "这只箱子有张标签。",
   "audio": {
    "file": "media/L097.mp4",
    "start": 34.3,
    "end": 37.5
   }
  },
  {
   "speaker": "Mr. Hall",
   "en": "Let me see it.",
   "zh": "让我看看。",
   "audio": {
    "file": "media/L097.mp4",
    "start": 37.5,
    "end": 40.1
   }
  },
  {
   "speaker": "Attendant",
   "en": "What's your name and address?",
   "zh": "您的姓名和住址？",
   "audio": {
    "file": "media/L097.mp4",
