 "dialogue": [
  {
   "speaker": "Mr. Williams",
   "en": "Where's Jimmy?",
   "zh": "吉米在哪儿？",
   "audio": {
    "file": "media/L061.mp4",
    "start": 6.9,
    "end": 9.1
   }
  },
  {
   "speaker": "Mrs. Williams",
   "en": "He's in bed.",
   "zh": "他躺在床上。",
   "audio": {
    "file": "media/L061.mp4",
    "start": 9.1,
    "end": 10.9
   }
  },
  {
   "speaker": "Mr. Williams",
   "en": "What's the matter with him?",
   "zh": "他怎么啦？",
   "audio": {
    "file": "media/L061.mp4",
    "start": 10.9,
    "end": 12.8
   }
  },
  {
   "speaker": "Mrs. Williams",
   "en": "He feels ill.",
   "zh": "他觉得不舒服。",
   "audio": {
    "file": "media/L061.mp4",
    "start": 12.8,
    "end": 14.7
   }
  },
  {
   "speaker": "Mr. Williams",
   "en": "He looks ill.",
   "zh": "他看上去是病了。",
   "audio": {
    "file": "media/L061.mp4",
    "start": 14.7,
    "end": 17.3
   }
  },
  {
   "speaker": "Mrs. Williams",
   "en": "We must call the doctor.",
   "zh": "我们得去请医生。",
   "audio": {
    "file": "media/L061.mp4",
    "start": 17.3,
    "end": 19.3
   }
  },
  {
   "speaker": "Mr. Williams",
   "en": "Yes, we must.",
   "zh": "是的，一定得请。",
   "audio": {
    "file": "media/L061.mp4",
    "start": 19.3,
    "end": 21.8
   }
  },
  {
   "speaker": "Mr. Williams",
   "en": "Can you remember the doctor's telephone number?",
   "zh": "你还记得医生的电话号码吗？",
   "audio": {
    "file": "media/L061.mp4",
    "start": 21.8,
    "end": 25.6
   }
  },
  {
   "speaker": "Mrs. Williams",
   "en": "Yes. It's 09754.",
   "zh": "记得。是 09754。",
   "audio": {
    "file": "media/L061.mp4",
    "start": 25.6,
    "end": 33.2
   }
  },
  {
   "speaker": "Doctor",
   "en": "Open your mouth, Jimmy.",
   "zh": "把嘴张开，吉米。",
   "audio": {
    "file": "media/L061.mp4",
    "start": 33.2,
    "end": 36.1
   }
  },
  {
   "speaker": "Doctor",
   "en": "Show me your tongue.",
   "zh": "让我看看你的舌头。",
   "audio": {
    "file": "media/L061.mp4",
    "start": 36.1,
    "end": 38.4
   }
  },
  {
   "speaker": "Doctor",
   "en": "Say, 'Ah'.",
   "zh": "说“啊——”。",
   "audio": {
    "file": "media/L061.mp4",
    "start": 38.4,
    "end": 42.2
   }
  },
  {
   "speaker": "Mr. Williams",
   "en": "What's the matter with him, doctor?",
   "zh": "他得了什么病，医生？",
   "audio": {
    "file": "media/L061.mp4",
    "start": 42.2,
    "end": 45.6
   }
  },
  {
   "speaker": "Doctor",
   "en": "He has a bad cold, Mr. Williams,",
   "zh": "他得了重感冒，威廉斯先生，",
   "audio": {
    "file": "media/L061.mp4",
    "start": 45.6,
    "end": 48.5
   }
  },
  {
   "speaker": "Doctor",
   "en": "so he must stay in bed for a week.",
   "zh": "因此他必须卧床一周。",
   "audio": {
    "file": "media/L061.mp4",
    "start": 48.5,
    "end": 52
   }
  },
  {
   "speaker": "Mrs. Williams",
   "en": "That's good news for Jimmy.",
   "zh": "对吉米来说，这可是个好消息。",
   "audio": {
    "file": "media/L061.mp4",
    "start": 52,
    "end": 54.8
   }
  },
  {
   "speaker": "Doctor",
   "en": "Good news?",
   "zh": "好消息？",
   "audio": {
    "file": "media/L061.mp4",
    "start": 54.8,
    "end": 56.2
   }
  },
  {
   "speaker": "Doctor",
   "en": "Why?",
   "zh": "为什么？",
   "audio": {
    "file": "media/L061.mp4",
    "start": 56.2,
    "end": 57.8
   }
  },
  {
   "speaker": "Mr. Williams",
   "en": "Because he doesn't like school!",
   "zh": "因为他不喜欢上学！",
   "audio": {
    "file": "media/L061.mp4",
    "start": 57.8,
    "end": 61.8
   }
  }
 ],
