 "dialogue": [
  {
   "speaker": "Hans",
   "en": "Where do you come from?",
   "zh": "你是哪国人？",
   "audio": {
    "file": "media/L051.mp4",
    "start": 7,
    "end": 10.4
   }
  },
  {
   "speaker": "Dimitri",
   "en": "I come from Greece.",
   "zh": "我是希腊人。",
   "audio": {
    "file": "media/L051.mp4",
    "start": 10.4,
    "end": 13.9
   }
  },
  {
   "speaker": "Hans",
   "en": "What's the climate like in your country?",
   "zh": "你们国家的气候怎么样？",
   "audio": {
    "file": "media/L051.mp4",
    "start": 13.9,
    "end": 18.4
   }
  },
  {
   "speaker": "Dimitri",
   "en": "It's very pleasant.",
   "zh": "气候非常宜人。",
   "audio": {
    "file": "media/L051.mp4",
    "start": 18.4,
    "end": 22.4
   }
  },
  {
   "speaker": "Hans",
   "en": "What's the weather like in spring?",
   "zh": "春季的天气怎么样？",
   "audio": {
    "file": "media/L051.mp4",
    "start": 22.4,
    "end": 26.9
   }
  },
  {
   "speaker": "Dimitri",
   "en": "It's often windy in March.",
   "zh": "3月里常常刮风。",
   "audio": {
    "file": "media/L051.mp4",
    "start": 26.9,
    "end": 30.4
   }
  },
  {
   "speaker": "Dimitri",
   "en": "It's always warm in April and May, but it rains sometimes.",
   "zh": "4月和5月的天气总是暖洋洋的，但有时下雨。",
   "audio": {
    "file": "media/L051.mp4",
    "start": 30.4,
    "end": 38.4
   }
  },
  {
   "speaker": "Hans",
   "en": "What's it like in summer?",
   "zh": "夏季的天气如何呢？",
   "audio": {
    "file": "media/L051.mp4",
    "start": 38.4,
    "end": 42.7
   }
  },
  {
   "speaker": "Dimitri",
   "en": "It's always hot in June, July and August.",
   "zh": "6月、7月和8月的天气总是炎热的，",
   "audio": {
    "file": "media/L051.mp4",
    "start": 42.7,
    "end": 48.2
   }
  },
  {
   "speaker": "Dimitri",
   "en": "The sun shines every day.",
   "zh": "每天都出太阳。",
   "audio": {
    "file": "media/L051.mp4",
    "start": 48.2,
    "end": 52
   }
  },
  {
   "speaker": "Hans",
   "en": "Is it cold or warm in autumn?",
   "zh": "秋季的天气是冷还是暖呢？",
   "audio": {
    "file": "media/L051.mp4",
    "start": 52,
    "end": 56.2
   }
  },
  {
   "speaker": "Dimitri",
   "en": "It's always warm in September and October.",
   "zh": "9月和10月总是很暖和，",
   "audio": {
    "file": "media/L051.mp4",
    "start": 56.2,
    "end": 61.2
   }
  },
  {
   "speaker": "Dimitri",
   "en": "It's often cold in November and it rains sometimes.",
   "zh": "11月常常就冷了，而且有时下雨。",
   "audio": {
    "file": "media/L051.mp4",
    "start": 61.2,
    "end": 67.4
   }
  },
  {
   "speaker": "Hans",
   "en": "Is it very cold in winter?",
   "zh": "冬季的天气很冷吗？",
   "audio": {
    "file": "media/L051.mp4",
    "start": 67.4,
    "end": 71.2
   }
  },
  {
   "speaker": "Dimitri",
   "en": "It's often cold in December, January and February.",
   "zh": "12月、1月和2月常常很冷，",
   "audio": {
    "file": "media/L051.mp4",
    "start": 71.2,
    "end": 77.4
   }
  },
  {
   "speaker": "Dimitri",
   "en": "It snows sometimes.",
   "zh": "有时还下雪。",
   "audio": {
    "file": "media/L051.mp4",
    "start": 77.4,
    "end": 80.9
   }
  }
 ],
