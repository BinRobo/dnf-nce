  "lines": [
    { "speaker": "Mr. Williams", "en": "Where's Jimmy?", "zh": "吉米在哪儿？" },
    { "speaker": "Mrs. Williams", "en": "He's in bed.", "zh": "他躺在床上。" },
    { "speaker": "Mr. Williams", "en": "What's the matter with him?", "zh": "他怎么啦？" },
    { "speaker": "Mrs. Williams", "en": "He feels ill.", "zh": "他觉得不舒服。" },
    { "speaker": "Mr. Williams", "en": "He looks ill.", "zh": "他看上去是病了。" },
    { "speaker": "Mrs. Williams", "en": "We must call the doctor.", "zh": "我们得去请医生。" },
    { "speaker": "Mr. Williams", "en": "Yes, we must.", "zh": "是的，一定得请。" },
    { "speaker": "Mr. Williams", "en": "Can you remember the doctor's telephone number?", "zh": "你还记得医生的电话号码吗？" },
    { "speaker": "Mrs. Williams", "en": "Yes. It's 09754.", "zh": "记得。是 09754。" },
    { "speaker": "Doctor", "en": "Open your mouth, Jimmy.", "zh": "把嘴张开，吉米。" },
    { "speaker": "Doctor", "en": "Show me your tongue.", "zh": "让我看看你的舌头。" },
    { "speaker": "Doctor", "en": "Say, 'Ah'.", "zh": "说“啊——”。" },
    { "speaker": "Mr. Williams", "en": "What's the matter with him, doctor?", "zh": "他得了什么病，医生？" },
    { "speaker": "Doctor", "en": "He has a bad cold, Mr. Williams,", "zh": "他得了重感冒，威廉斯先生，" },
    { "speaker": "Doctor", "en": "so he must stay in bed for a week.", "zh": "因此他必须卧床一周。" },
    { "speaker": "Mrs. Williams", "en": "That's good news for Jimmy.", "zh": "对吉米来说，这可是个好消息。" },
    { "speaker": "Doctor", "en": "Good news?", "zh": "好消息？" },
    { "speaker": "Doctor", "en": "Why?", "zh": "为什么？" },
    { "speaker": "Mr. Williams", "en": "Because he doesn't like school!", "zh": "因为他不喜欢上学！" }
  ],
