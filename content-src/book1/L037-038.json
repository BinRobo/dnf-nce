  "lines": [
    {
      "speaker": "Dan",
      "en": "You're working hard, George.",
      "zh": "你干得真辛苦，乔治。"
    },
    {
      "speaker": "Dan",
      "en": "What are you doing?",
      "zh": "你在干什么呢？"
    },
    {
      "speaker": "George",
      "en": "I'm making a bookcase.",
      "zh": "我正在做书架。"
    },
    {
      "speaker": "George",
      "en": "Give me that hammer please, Dan.",
      "zh": "请把那把锤子拿给我，丹。"
    },
    {
      "speaker": "Dan",
      "en": "Which hammer?",
      "zh": "哪一把？"
    },
    {
      "speaker": "Dan",
      "en": "This one?",
      "zh": "是这把吗？"
    },
    {
      "speaker": "George",
      "en": "No, not that one.",
      "zh": "不，不是那把。"
    },
    {
      "speaker": "George",
      "en": "The big one.",
      "zh": "是那把大的。"
    },
    {
      "speaker": "Dan",
      "en": "Here you are.",
      "zh": "给你。"
    },
    {
      "speaker": "George",
      "en": "Thanks, Dan.",
      "zh": "谢谢，丹。"
    },
    {
      "speaker": "Dan",
      "en": "What are you going to do now, George?",
      "zh": "你现在打算干什么，乔治？"
    },
    {
      "speaker": "George",
      "en": "I'm going to paint it.",
      "zh": "我打算把它漆一下。"
    },
    {
      "speaker": "Dan",
      "en": "What colour are you going to paint it?",
      "zh": "你打算把它漆成什么颜色？"
    },
    {
      "speaker": "George",
      "en": "I'm going to paint it pink.",
      "zh": "我想漆成粉红色。"
    },
    {
      "speaker": "Dan",
      "en": "Pink!",
      "zh": "粉红色！"
    },
    {
      "speaker": "George",
      "en": "This bookcase isn't for me.",
      "zh": "这个书架不是为我做的，"
    },
    {
      "speaker": "George",
      "en": "It's for my daughter, Susan.",
      "zh": "是为我的女儿苏珊做的。"
    },
    {
      "speaker": "George",
      "en": "Pink's her favourite colour.",
      "zh": "粉红色是她最喜欢的颜色。"
    }
  ],
