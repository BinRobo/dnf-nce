  "lines": [
    { "speaker": "Father", "en": "What are you going to do this evening, Jill?", "zh": "今晚你打算干什么，吉尔？" },
    { "speaker": "Jill", "en": "I'm going to meet some friends, Dad.", "zh": "我打算去看几个朋友，爸爸。" },
    { "speaker": "Father", "en": "You mustn't come home late.", "zh": "你不准回家太晚。" },
    { "speaker": "Father", "en": "You must be home at half past ten.", "zh": "你必须在 10 点半到家。" },
    { "speaker": "Jill", "en": "I can't get home so early, Dad!", "zh": "这么早我到不了家，爸爸！" },
    { "speaker": "Jill", "en": "Can I have the key to the front door, please?", "zh": "我能带上前门的钥匙吗？" },
    { "speaker": "Father", "en": "No, you can't.", "zh": "不行，你不能带。" },
    { "speaker": "Mother", "en": "Jill's eighteen years old, Tom.", "zh": "吉尔都 18 岁了，汤姆。" },
    { "speaker": "Mother", "en": "She's not a baby.", "zh": "她不是小孩子了。" },
    { "speaker": "Mother", "en": "Give her the key.", "zh": "把钥匙给她吧。" },
    { "speaker": "Mother", "en": "She always comes home early.", "zh": "她总是早早回家的。" },
    { "speaker": "Father", "en": "Oh, all right!", "zh": "那么，好吧！" },
    { "speaker": "Father", "en": "Here you are.", "zh": "拿去。" },
    { "speaker": "Father", "en": "But you mustn't come home after a quarter past eleven.", "zh": "但你不能超过 11 点 1 刻回家。" },
    { "speaker": "Father", "en": "Do you hear?", "zh": "听见了吗？" },
    { "speaker": "Jill", "en": "Yes, Dad.", "zh": "听见了，爸爸。" },
    { "speaker": "Jill", "en": "Thanks, Mum.", "zh": "谢谢，妈妈。" },
    { "speaker": "Mother", "en": "That's all right.", "zh": "不用谢。" },
    { "speaker": "Mother", "en": "Goodbye.", "zh": "再见。" },
    { "speaker": "Mother", "en": "Enjoy yourself!", "zh": "好好玩吧！" },
    { "speaker": "Jill", "en": "We always enjoy ourselves, Mum.", "zh": "我们总是玩得很开心的，妈妈。" },
    { "speaker": "Jill", "en": "Bye-bye.", "zh": "再见。" }
  ],
