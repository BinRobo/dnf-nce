  "lines": [
    {
      "speaker": "Man",
      "en": "Give me some glasses please, Jane.",
      "zh": "请拿给我几只玻璃杯，简。"
    },
    {
      "speaker": "Woman",
      "en": "Which glasses?",
      "zh": "哪几只？"
    },
    {
      "speaker": "Woman",
      "en": "These glasses?",
      "zh": "是这几只吗？"
    },
    {
      "speaker": "Man",
      "en": "No, not those.",
      "zh": "不，不是那几只。"
    },
    {
      "speaker": "Man",
      "en": "The ones on the shelf.",
      "zh": "是架子上的那几只。"
    },
    {
      "speaker": "Woman",
      "en": "These?",
      "zh": "这几只？"
    },
    {
      "speaker": "Man",
      "en": "Yes, please.",
      "zh": "是的，请拿给我。"
    },
    {
      "speaker": "Woman",
      "en": "Here you are.",
      "zh": "给你。"
    },
    {
      "speaker": "Man",
      "en": "Thanks.",
      "zh": "谢谢。"
    }
  ],
