  "lines": [
    {
      "speaker": "George",
      "en": "Two return tickets to London, please.",
      "zh": "买两张到伦敦的往返票。"
    },
    {
      "speaker": "George",
      "en": "What time will the next train leave?",
      "zh": "下一班火车什么时候开？"
    },
    {
      "speaker": "Attendant",
      "en": "At nineteen minutes past eight.",
      "zh": "8 点 19 分。"
    },
    {
      "speaker": "George",
      "en": "Which platform?",
      "zh": "在哪个站台？"
    },
    {
      "speaker": "Attendant",
      "en": "Platform Two. Over the bridge.",
      "zh": "2 号站台。过天桥。"
    },
    {
      "speaker": "Ken",
      "en": "What time will the next train leave?",
      "zh": "下一班火车什么时候开？"
    },
    {
      "speaker": "George",
      "en": "At eight nineteen.",
      "zh": "8 点 19 分。"
    },
    {
      "speaker": "Ken",
      "en": "We've got plenty of time.",
      "zh": "我们的时间还很宽裕。"
    },
    {
      "speaker": "George",
      "en": "It's only three minutes to eight.",
      "zh": "现在才 7 点 57 分。"
    },
    {
      "speaker": "Ken",
      "en": "Let's go and have a drink.",
      "zh": "让我们去喝点东西吧。"
    },
    {
      "speaker": "Ken",
      "en": "There's a bar next door to the station.",
      "zh": "车站旁有一个酒吧。"
    },
    {
      "speaker": "George",
      "en": "We had better go back to the station now, Ken.",
      "zh": "肯，我们现在最好回到车站去。"
    },
    {
      "speaker": "Porter",
      "en": "Tickets, please.",
      "zh": "请把车票拿出来。"
    },
    {
      "speaker": "George",
      "en": "We want to catch the eight nineteen to London.",
      "zh": "我们要乘 8 点 19 分的车去伦敦。"
    },
    {
      "speaker": "Porter",
      "en": "You've just missed it!",
      "zh": "你们刚好错过了那班车。"
    },
    {
      "speaker": "George",
      "en": "What!",
      "zh": "什么！"
    },
    {
      "speaker": "George",
      "en": "It's only eight fifteen.",
      "zh": "现在只有 8 点 15 分。"
    },
    {
      "speaker": "Porter",
      "en": "I'm sorry, sir.",
      "zh": "对不起，先生。"
    },
    {
      "speaker": "Porter",
      "en": "That clock's ten minutes slow.",
      "zh": "那个钟慢了 10 分钟。"
    },
    {
      "speaker": "George",
      "en": "When's the next train?",
      "zh": "下一班车是什么时候？"
    },
    {
      "speaker": "Porter",
      "en": "In five hours' time!",
      "zh": "5 个小时以后！"
    }
  ],
