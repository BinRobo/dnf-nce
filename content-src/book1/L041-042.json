  "lines": [
    { "speaker": "Sam", "en": "Is that bag heavy, Penny?", "zh": "那个提包重吗，彭妮？" },
    { "speaker": "Penny", "en": "Not very.", "zh": "不太重。" },
    { "speaker": "Sam", "en": "Here!", "zh": "放这儿。" },
    { "speaker": "Sam", "en": "Put it on this chair.", "zh": "把它放在这把椅子上。" },
    { "speaker": "Sam", "en": "What's in it?", "zh": "里面是什么东西？" },
    { "speaker": "Penny", "en": "A piece of cheese.", "zh": "一块乳酪，" },
    { "speaker": "Penny", "en": "A loaf of bread.", "zh": "一个面包，" },
    { "speaker": "Penny", "en": "A bar of soap.", "zh": "一块肥皂，" },
    { "speaker": "Penny", "en": "A bar of chocolate.", "zh": "一块巧克力，" },
    { "speaker": "Penny", "en": "A bottle of milk.", "zh": "一瓶牛奶，" },
    { "speaker": "Penny", "en": "A pound of sugar.", "zh": "一磅糖，" },
    { "speaker": "Penny", "en": "Half a pound of coffee.", "zh": "半磅咖啡，" },
    { "speaker": "Penny", "en": "A quarter of a pound of tea.", "zh": "1/4 磅茶叶，" },
    { "speaker": "Penny", "en": "And a tin of tobacco.", "zh": "和一听烟丝。" },
    { "speaker": "Sam", "en": "Is that tin of tobacco for me?", "zh": "那听烟丝是给我的吗？" },
    { "speaker": "Penny", "en": "Well, it's certainly not for me!", "zh": "噢，当然不会是给我的！" }
  ],
