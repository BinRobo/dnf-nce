  "lines": [
    { "speaker": "Christine", "en": "Do you like coffee, Ann?", "zh": "你喜欢咖啡吗，安？" },
    { "speaker": "Ann", "en": "Yes, I do.", "zh": "是的，我喜欢。" },
    { "speaker": "Christine", "en": "Do you want a cup?", "zh": "你想要一杯吗？" },
    { "speaker": "Ann", "en": "Yes, please, Christine.", "zh": "好的，请来一杯，克里斯廷。" },
    { "speaker": "Christine", "en": "Do you want any sugar?", "zh": "你要放些糖吗？" },
    { "speaker": "Ann", "en": "Yes, please.", "zh": "好的，请放一些。" },
    { "speaker": "Christine", "en": "Do you want any milk?", "zh": "要放些牛奶吗？" },
    { "speaker": "Ann", "en": "No, thank you.", "zh": "不了，谢谢。" },
    { "speaker": "Ann", "en": "I don't like milk in my coffee.", "zh": "我不喜欢咖啡中放牛奶，" },
    { "speaker": "Ann", "en": "I like black coffee.", "zh": "我喜欢清咖啡。" },
    { "speaker": "Christine", "en": "Do you like biscuits?", "zh": "你喜欢饼干吗？" },
    { "speaker": "Ann", "en": "Yes, I do.", "zh": "是的，我喜欢。" },
    { "speaker": "Christine", "en": "Do you want one?", "zh": "你想要一块吗？" },
    { "speaker": "Ann", "en": "Yes, please.", "zh": "好的，请来一块。" }
  ],
