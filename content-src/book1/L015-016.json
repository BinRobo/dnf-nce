  "lines": [
    {
      "speaker": "Customs officer",
      "en": "Are you Swedish?",
      "zh": "你们是瑞典人吗？"
    },
    {
      "speaker": "Girls",
      "en": "No, we are not.",
      "zh": "不，我们不是瑞典人。"
    },
    {
      "speaker": "Girls",
      "en": "We are Danish.",
      "zh": "我们是丹麦人。"
    },
    {
      "speaker": "Customs officer",
      "en": "Are your friends Danish, too?",
      "zh": "你们的朋友也是丹麦人吗？"
    },
    {
      "speaker": "Girls",
      "en": "No, they aren't.",
      "zh": "不，他们不是丹麦人。"
    },
    {
      "speaker": "Girls",
      "en": "They are Norwegian.",
      "zh": "他们是挪威人。"
    },
    {
      "speaker": "Customs officer",
      "en": "Your passports, please.",
      "zh": "请出示你们的护照。"
    },
    {
      "speaker": "Girls",
      "en": "Here they are.",
      "zh": "给您。"
    },
    {
      "speaker": "Customs officer",
      "en": "Are these your cases?",
      "zh": "这些是你们的箱子吗？"
    },
    {
      "speaker": "Girls",
      "en": "No, they aren't.",
      "zh": "不，不是。"
    },
    {
      "speaker": "Girls",
      "en": "Our cases are brown.",
      "zh": "我们的箱子是棕色的。"
    },
    {
      "speaker": "Girls",
      "en": "Here they are.",
      "zh": "在这儿呢。"
    },
    {
      "speaker": "Customs officer",
      "en": "Are you tourists?",
      "zh": "你们是来旅游的吗？"
    },
    {
      "speaker": "Girls",
      "en": "Yes, we are.",
      "zh": "是的，我们是来旅游的。"
    },
    {
      "speaker": "Customs officer",
      "en": "Are your friends tourists too?",
      "zh": "你们的朋友也是来旅游的吗？"
    },
    {
      "speaker": "Girls",
      "en": "Yes, they are.",
      "zh": "是的，他们也是。"
    },
    {
      "speaker": "Customs officer",
      "en": "That's fine.",
      "zh": "好了。"
    },
    {
      "speaker": "Girls",
      "en": "Thank you very much.",
      "zh": "非常感谢。"
    }
  ],
