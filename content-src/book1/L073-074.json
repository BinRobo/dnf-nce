  "lines": [
    { "en": "Last week Mrs. Mills went to London.", "zh": "上星期米尔斯夫人去了伦敦。" },
    { "en": "She does not know London very well, and she lost her way.", "zh": "她对伦敦不很熟悉，因此迷了路。" },
    { "en": "Suddenly, she saw a man near a bus stop.", "zh": "突然，她在公共汽车站附近看到一个男人。" },
    { "en": "'I can ask him the way,' she said to herself.", "zh": "“我可以向他问路，”她想。" },
    { "en": "'Excuse me,' she said.", "zh": "“对不起，”她说。" },
    { "en": "'Can you tell me the way to King Street, please?'", "zh": "“您能告诉我到国王街怎么走吗？”" },
    { "en": "The man smiled pleasantly.", "zh": "这人友好地笑了笑。" },
    { "en": "He did not understand English!", "zh": "他不懂英语！" },
    { "en": "He spoke German.", "zh": "他讲德语。" },
    { "en": "He was a tourist.", "zh": "他是个旅游者。" },
    { "en": "Then he put his hand into his pocket,", "zh": "然后他把手伸进了衣袋，" },
    { "en": "and took out a phrasebook.", "zh": "掏出了一本常用语手册。" },
    { "en": "He opened the book and found a phrase.", "zh": "他翻开书找到了一条短语。" },
    { "en": "He read the phrase slowly.", "zh": "他缓慢地读着短语。" },
    { "en": "'I am sorry,' he said.", "zh": "“很抱歉，”他说。" },
    { "en": "'I do not speak English.'", "zh": "“我不会讲英语。”" }
  ],
