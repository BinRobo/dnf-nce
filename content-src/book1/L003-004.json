  "lines": [
    {
      "en": "My coat and my umbrella please.",
      "zh": "请把我的大衣和伞拿给我。"
    },
    {
      "en": "Here is my ticket.",
      "zh": "这是我（寄存东西）的牌子。"
    },
    {
      "en": "Thank you, sir.",
      "zh": "谢谢，先生。"
    },
    {
      "en": "Number five.",
      "zh": "是5号。"
    },
    {
      "en": "Here's your umbrella and your coat.",
      "zh": "这是您的伞和大衣。"
    },
    {
      "en": "This is not my umbrella.",
      "zh": "这不是我的伞。"
    },
    {
      "en": "Sorry, sir.",
      "zh": "对不起，先生。"
    },
    {
      "en": "Is this your umbrella?",
      "zh": "这把伞是您的吗？"
    },
    {
      "en": "No, it isn't.",
      "zh": "不，不是！"
    },
    {
      "en": "Is this it?",
      "zh": "这把是吗？"
    },
    {
      "en": "Yes, it is.",
      "zh": "是，是这把。"
    },
    {
      "en": "Thank you very much.",
      "zh": "非常感谢。"
    }
  ],
