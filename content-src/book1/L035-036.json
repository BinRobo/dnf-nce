  "lines": [
    { "en": "This is a photograph of our village.", "zh": "这是我们村庄的一张照片。" },
    { "en": "Our village is in a valley.", "zh": "我们的村庄坐落在一个山谷之中。" },
    { "en": "It is between two hills.", "zh": "它位于两座小山之间。" },
    { "en": "The village is on a river.", "zh": "它靠近一条小河。" },
    { "en": "Here is another photograph of the village.", "zh": "这是我们村庄的另一张照片。" },
    { "en": "My wife and I are walking along the banks of the river.", "zh": "我和妻子正沿河岸走着。" },
    { "en": "We are on the left.", "zh": "我们在河的左侧。" },
    { "en": "There is a boy in the water.", "zh": "河里面有个男孩。" },
    { "en": "He is swimming across the river.", "zh": "他正横渡小河。" },
    { "en": "Here is another photograph.", "zh": "这是另一张照片。" },
    { "en": "This is the school building.", "zh": "这是学校大楼。" },
    { "en": "It is beside a park.", "zh": "它位于公园的旁边。" },
    { "en": "The park is on the right.", "zh": "公园在右面。" },
    { "en": "Some children are coming out of the building.", "zh": "一些孩子正从楼里出来。" },
    { "en": "Some of them are going into the park.", "zh": "他们中有几个正走进公园。" }
