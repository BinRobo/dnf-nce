 "lines": [
  {
   "speaker": "Mike",
   "en": "Look, Scott.",
   "zh": "看，斯科特。"
  },
  {
   "speaker": "Mike",
   "en": "This is a photograph I took during my trip to Australia.",
   "zh": "这是我到澳大利亚旅行时拍的一张照片。"
  },
  {
   "speaker": "Scott",
   "en": "Let me see it, Mike.",
   "zh": "让我看看，迈克。"
  },
  {
   "speaker": "Scott",
   "en": "This is a good photograph.",
   "zh": "这是一张很好的照片。"
  },
  {
   "speaker": "Scott",
   "en": "Who are these people?",
   "zh": "这些人是谁？"
  },
  {
   "speaker": "Mike",
   "en": "They're people I met during the trip.",
   "zh": "他们是我旅行时认识的人。"
  },
  {
   "speaker": "Mike",
   "en": "That's the ship we travelled on.",
   "zh": "这是我们所乘的那条船。"
  },
  {
   "speaker": "Scott",
   "en": "What a beautiful ship!",
   "zh": "多漂亮的船啊！"
  },
  {
   "speaker": "Scott",
   "en": "Who's this?",
   "zh": "这是谁？"
  },
  {
   "speaker": "Mike",
   "en": "That's the man I told you about.",
   "zh": "这就是我跟你说过的那个人。"
  },
  {
   "speaker": "Mike",
   "en": "Remember?",
   "zh": "还记得吗？"
  },
  {
   "speaker": "Scott",
   "en": "Ah yes.",
   "zh": "啊，记得。"
  },
  {
   "speaker": "Scott",
   "en": "The one who offered you a job in Australia.",
   "zh": "就是在澳大利亚给你工作做的那个人。"
  },
  {
   "speaker": "Mike",
   "en": "That's right.",
   "zh": "对。"
  },
  {
   "speaker": "Scott",
   "en": "Who's this?",
   "zh": "这是谁？"
  },
  {
   "speaker": "Mike",
   "en": "Guess!",
   "zh": "你猜！"
  },
  {
   "speaker": "Scott",
   "en": "It's not you, is it?",
   "zh": "这不是你，对吗？"
  },
  {
   "speaker": "Mike",
   "en": "That's right.",
   "zh": "不，是我。"
  },
  {
   "speaker": "Mike",
   "en": "I grew a beard during the trip,",
   "zh": "我在旅行时留了胡子，"
  },
  {
   "speaker": "Mike",
   "en": "but I shaved it off when I came home.",
   "zh": "但我回到家时就把它刮了。"
  },
  {
   "speaker": "Scott",
   "en": "Why did you shave it off?",
   "zh": "你为什么把它刮了？"
  },
  {
   "speaker": "Mike",
   "en": "My wife didn't like it!",
   "zh": "我妻子不喜欢！"
  }
 ],
