  "lines": [
    {
      "speaker": "The boss",
      "en": "Can you come here a minute please, Bob?",
      "zh": "请你来一下好吗，鲍勃？"
    },
    {
      "speaker": "Bob",
      "en": "Yes, sir?",
      "zh": "什么事，先生？"
    },
    {
      "speaker": "The boss",
      "en": "Where's Pamela?",
      "zh": "帕梅拉在哪儿？"
    },
    {
      "speaker": "Bob",
      "en": "She's next door.",
      "zh": "她在隔壁，"
    },
    {
      "speaker": "Bob",
      "en": "She's in her office, sir.",
      "zh": "在她的办公室里，先生。"
    },
    {
      "speaker": "The boss",
      "en": "Can she type this letter for me?",
      "zh": "她能为我打一下这封信吗？"
    },
    {
      "speaker": "The boss",
      "en": "Ask her please.",
      "zh": "请问问她。"
    },
    {
      "speaker": "Bob",
      "en": "Yes, sir.",
      "zh": "好的，先生。"
    },
    {
      "speaker": "Bob",
      "en": "Can you type this letter for the boss please, Pamela?",
      "zh": "请你把这封信给老板打一下可以吗，帕梅拉？"
    },
    {
      "speaker": "Pamela",
      "en": "Yes, of course I can.",
      "zh": "可以，当然可以。"
    },
    {
      "speaker": "Bob",
      "en": "Here you are.",
      "zh": "给你这信。"
    },
    {
      "speaker": "Pamela",
      "en": "Thank you, Bob.",
      "zh": "谢谢你，鲍勃。"
    },
    {
      "speaker": "Pamela",
      "en": "Bob!",
      "zh": "鲍勃！"
    },
    {
      "speaker": "Bob",
      "en": "Yes?",
      "zh": "怎么了？"
    },
    {
      "speaker": "Bob",
      "en": "What's the matter?",
      "zh": "怎么回事？"
    },
    {
      "speaker": "Pamela",
      "en": "I can't type this letter.",
      "zh": "我打不了这封信。"
    },
    {
      "speaker": "Pamela",
      "en": "I can't read it!",
      "zh": "我看不懂这封信，"
    },
    {
      "speaker": "Pamela",
      "en": "The boss's handwriting is terrible!",
      "zh": "老板的书写太糟糕了！"
    }
  ],
