  "lines": [
    {
      "speaker": "Teacher",
      "en": "Whose shirt is that?",
      "zh": "那是谁的衬衫？"
    },
    {
      "speaker": "Teacher",
      "en": "Is this your shirt, Dave?",
      "zh": "戴夫，这是你的衬衫吗？"
    },
    {
      "speaker": "Dave",
      "en": "No, sir.",
      "zh": "不，先生。"
    },
    {
      "speaker": "Dave",
      "en": "It's not my shirt.",
      "zh": "这不是我的衬衫。"
    },
    {
      "speaker": "Dave",
      "en": "This is my shirt. My shirt's blue.",
      "zh": "这是我的衬衫。我的衬衫是蓝色的。"
    },
    {
      "speaker": "Teacher",
      "en": "Is this shirt Tim's?",
      "zh": "这件衬衫是蒂姆的吗？"
    },
    {
      "speaker": "Dave",
      "en": "Perhaps it is, sir.",
      "zh": "也许是，先生。"
    },
    {
      "speaker": "Dave",
      "en": "Tim's shirt's white.",
      "zh": "蒂姆的衬衫是白色的。"
    },
    {
      "speaker": "Teacher",
      "en": "Tim!",
      "zh": "蒂姆！"
    },
    {
      "speaker": "Tim",
      "en": "Yes, sir?",
      "zh": "什么事，先生？"
    },
    {
      "speaker": "Teacher",
      "en": "Is this your shirt?",
      "zh": "这是你的衬衫吗？"
    },
    {
      "speaker": "Tim",
      "en": "Yes, sir.",
      "zh": "是的，先生。"
    },
    {
      "speaker": "Teacher",
      "en": "Here you are.",
      "zh": "给你。"
    },
    {
      "speaker": "Teacher",
      "en": "Catch!",
      "zh": "接着！"
    },
    {
      "speaker": "Tim",
      "en": "Thank you, sir.",
      "zh": "谢谢您，先生。"
    }
  ],
