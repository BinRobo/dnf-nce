 "lines": [
  {
   "speaker": "Susan",
   "en": "Can't you come in and have tea now, Peter?",
   "zh": "彼得，你现在能进来喝茶吗？"
  },
  {
   "speaker": "Peter",
   "en": "Not yet.",
   "zh": "还不能。"
  },
  {
   "speaker": "Peter",
   "en": "I must water the garden first.",
   "zh": "我得先给花园浇水。"
  },
  {
   "speaker": "Susan",
   "en": "Do you have to water it now?",
   "zh": "你一定得现在浇吗？"
  },
  {
   "speaker": "Peter",
   "en": "I'm afraid I must.",
   "zh": "恐怕我得现在浇。"
  },
  {
   "speaker": "Peter",
   "en": "Look at it!",
   "zh": "你看看，"
  },
  {
   "speaker": "Peter",
   "en": "It's terribly dry.",
   "zh": "干得厉害。"
  },
  {
   "speaker": "Susan",
   "en": "What a nuisance!",
   "zh": "真讨厌！"
  },
  {
   "speaker": "Peter",
   "en": "Last summer it was very dry, too.",
   "zh": "去年夏天也是干得很。"
  },
  {
   "speaker": "Peter",
   "en": "Don't you remember?",
   "zh": "你不记得了吗？"
  },
  {
   "speaker": "Peter",
   "en": "I had to water it every day.",
   "zh": "我不得不每天浇水。"
  },
  {
   "speaker": "Susan",
   "en": "Well, I'll have tea by myself.",
   "zh": "好吧，我一个人喝茶了。"
  },
  {
   "speaker": "Susan",
   "en": "That was quick!",
   "zh": "好快啊！"
  },
  {
   "speaker": "Susan",
   "en": "Have you finished already?",
   "zh": "你已经浇完了？"
  },
  {
   "speaker": "Peter",
   "en": "Yes.",
   "zh": "是的。"
  },
  {
   "speaker": "Peter",
   "en": "Look out of the window.",
   "zh": "你看看窗外。"
  },
  {
   "speaker": "Susan",
   "en": "It's raining!",
   "zh": "下雨了！"
  },
  {
   "speaker": "Susan",
   "en": "That means you don't need to water the garden.",
   "zh": "这就是说，你不必给花园浇水了。"
  },
  {
   "speaker": "Peter",
   "en": "That was a pleasant surprise.",
   "zh": "这是意想不到的好事。"
  },
  {
   "speaker": "Peter",
   "en": "It means I can have tea, instead.",
   "zh": "这意味着我反倒可以喝茶了。"
  }
 ],
