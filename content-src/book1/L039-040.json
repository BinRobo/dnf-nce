  "lines": [
    {
      "speaker": "Sam",
      "en": "What are you going to do with that vase, Penny?",
      "zh": "你打算如何处理那花瓶，彭妮？"
    },
    {
      "speaker": "Penny",
      "en": "I'm going to put it on this table, Sam.",
      "zh": "我打算把它放在这张桌子上，萨姆。"
    },
    {
      "speaker": "Sam",
      "en": "Don't do that.",
      "zh": "不要放在那儿，"
    },
    {
      "speaker": "Sam",
      "en": "Give it to me.",
      "zh": "把它给我。"
    },
    {
      "speaker": "Penny",
      "en": "What are you going to do with it?",
      "zh": "你打算怎么办？"
    },
    {
      "speaker": "Sam",
      "en": "I'm going to put it here, in front of the window.",
      "zh": "我准备把它放在这儿，放在窗前。"
    },
    {
      "speaker": "Penny",
      "en": "Be careful!",
      "zh": "小心点！"
    },
    {
      "speaker": "Penny",
      "en": "Don't drop it!",
      "zh": "别摔了！"
    },
    {
      "speaker": "Penny",
      "en": "Don't put it there, Sam.",
      "zh": "别放在那儿，萨姆。"
    },
    {
      "speaker": "Penny",
      "en": "Put it here, on this shelf.",
      "zh": "放在这儿，这个架子上。"
    },
    {
      "speaker": "Sam",
      "en": "There we are!",
      "zh": "放好了！"
    },
    {
      "speaker": "Sam",
      "en": "It's a lovely vase.",
      "zh": "这是只漂亮的花瓶。"
    },
    {
      "speaker": "Penny",
      "en": "Those flowers are lovely, too.",
      "zh": "那些花也很漂亮啊。"
    }
  ],
