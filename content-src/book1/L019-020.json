  "lines": [
    { "speaker": "Mother", "en": "What's the matter, children?", "zh": "怎么啦，孩子们？" },
    { "speaker": "Girl", "en": "We're tired ...", "zh": "我们累了……" },
    { "speaker": "Boy", "en": "... and thirsty, Mum.", "zh": "……口也渴，妈妈。" },
    { "speaker": "Mother", "en": "Sit down here.", "zh": "坐在这儿吧。" },
    { "speaker": "Mother", "en": "Are you all right now?", "zh": "你们现在好些了吗？" },
    { "speaker": "Boy", "en": "No, we aren't.", "zh": "不，还没有。" },
    { "speaker": "Mother", "en": "Look!", "zh": "瞧！" },
    { "speaker": "Mother", "en": "There's an ice cream man.", "zh": "有个卖冰淇淋的。" },
    { "speaker": "Mother", "en": "Two ice creams please.", "zh": "请拿两份冰淇淋。" },
    { "speaker": "Mother", "en": "Here you are, children.", "zh": "拿着，孩子们。" },
    { "speaker": "Children", "en": "Thanks, Mum.", "zh": "谢谢，妈妈。" },
    { "speaker": "Girl", "en": "These ice creams are nice.", "zh": "这些冰淇淋真好吃。" },
    { "speaker": "Mother", "en": "Are you all right now?", "zh": "你们现在好了吗？" },
    { "speaker": "Children", "en": "Yes, we are, thank you!", "zh": "是的，现在好了，谢谢您！" }
