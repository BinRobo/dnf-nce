 "lines": [
  {
   "speaker": "Mr. Hall",
   "en": "I left a suitcase on the train to London the other day.",
   "zh": "几天前我把一只手提箱忘在开往伦敦的火车上了。"
  },
  {
   "speaker": "Attendant",
   "en": "Can you describe it, sir?",
   "zh": "先生，您能描述一下它是什么样子的吗？"
  },
  {
   "speaker": "Mr. Hall",
   "en": "It's a small blue case and it's got a zip.",
   "zh": "是只蓝色的小箱子，上面有拉链。"
  },
  {
   "speaker": "Mr. Hall",
   "en": "There's a label on the handle with my name and address on it.",
   "zh": "箱把上有一标签，上面写着我的姓名和住址。"
  },
  {
   "speaker": "Attendant",
   "en": "Is this case yours?",
   "zh": "这箱子是您的吗？"
  },
  {
   "speaker": "Mr. Hall",
   "en": "No, that's not mine.",
   "zh": "不，那不是我的。"
  },
  {
   "speaker": "Attendant",
   "en": "What about this one?",
   "zh": "这只是不是？"
  },
  {
   "speaker": "Attendant",
   "en": "This one's got a label.",
   "zh": "这只箱子有张标签。"
  },
  {
   "speaker": "Mr. Hall",
   "en": "Let me see it.",
   "zh": "让我看看。"
  },
  {
   "speaker": "Attendant",
   "en": "What's your name and address?",
   "zh": "您的姓名和住址？"
  },
  {
   "speaker": "Mr. Hall",
   "en": "David Hall, 83, Bridge Street.",
   "zh": "大卫·霍尔，大桥街 83 号。"
  },
  {
   "speaker": "Attendant",
   "en": "That's right.",
   "zh": "那就对了。"
  },
  {
   "speaker": "Attendant",
   "en": "D. N. Hall, 83, Bridge Street.",
   "zh": "D·N·霍尔，大桥街 83 号。"
  },
  {
   "speaker": "Attendant",
   "en": "Three pounds fifty pence, please.",
   "zh": "请付 3 英镑 50 便士。"
  },
  {
   "speaker": "Mr. Hall",
   "en": "Here you are.",
   "zh": "给您。"
  },
  {
   "speaker": "Attendant",
   "en": "Thank you.",
   "zh": "谢谢您。"
  },
  {
   "speaker": "Mr. Hall",
   "en": "Hey!",
   "zh": "嗨！"
  },
  {
   "speaker": "Attendant",
   "en": "What's the matter?",
   "zh": "怎么回事？"
  },
  {
   "speaker": "Mr. Hall",
   "en": "This case doesn't belong to me!",
   "zh": "这箱子不是我的！"
  },
  {
   "speaker": "Mr. Hall",
   "en": "You've given me the wrong case!",
   "zh": "您给错了！"
  }
 ],
