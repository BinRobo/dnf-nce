  "lines": [
    {
      "speaker": "Mrs. Jones",
      "en": "Come in, Amy.",
      "zh": "进来，艾米。"
    },
    {
      "speaker": "Mrs. Jones",
      "en": "Shut the door, please.",
      "zh": "请把门关上。"
    },
    {
      "speaker": "Mrs. Jones",
      "en": "This bedroom's very untidy.",
      "zh": "这卧室太不整洁了。"
    },
    {
      "speaker": "Amy",
      "en": "What must I do, Mrs. Jones?",
      "zh": "我应该做些什么呢，琼斯夫人？"
    },
    {
      "speaker": "Mrs. Jones",
      "en": "Open the window and air the room.",
      "zh": "打开窗子，给房间通通风。"
    },
    {
      "speaker": "Mrs. Jones",
      "en": "Then put these clothes in the wardrobe.",
      "zh": "然后把这些衣服放进衣橱里去。"
    },
    {
      "speaker": "Mrs. Jones",
      "en": "Then make the bed.",
      "zh": "再把床整理一下。"
    },
    {
      "speaker": "Mrs. Jones",
      "en": "Dust the dressing table.",
      "zh": "掸掉梳妆台上的灰尘。"
    },
    {
      "speaker": "Mrs. Jones",
      "en": "Then sweep the floor.",
      "zh": "然后扫扫地。"
    }
  ],
