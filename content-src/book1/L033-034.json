  "lines": [
    {
      "en": "It is a fine day today.",
      "zh": "今天天气好。"
    },
    {
      "en": "There are some clouds in the sky, but the sun is shining.",
      "zh": "天空中飘着几朵云，但阳光灿烂。"
    },
    {
      "en": "Mr. Jones is with his family.",
      "zh": "琼斯先生同他的家人在一起。"
    },
    {
      "en": "They are walking over the bridge.",
      "zh": "他们正在过桥。"
    },
    {
      "en": "There are some boats on the river.",
      "zh": "河上有几艘船。"
    },
    {
      "en": "Mr. Jones and his wife are looking at them.",
      "zh": "琼斯先生和他的妻子正在看这些船。"
    },
    {
      "en": "Sally is looking at a big ship.",
      "zh": "萨莉正在观看一艘大船。"
    },
    {
      "en": "The ship is going under the bridge.",
      "zh": "那船正从桥下驶过。"
    },
    {
      "en": "Tim is looking at an aeroplane.",
      "zh": "蒂姆正望着一架飞机。"
    },
    {
      "en": "The aeroplane is flying over the river.",
      "zh": "飞机正从河上飞过。"
    }
  ],
