  "lines": [
    { "speaker": "Lady", "en": "I want some envelopes, please.", "zh": "请给我拿几个信封。" },
    { "speaker": "Shop assistant", "en": "Do you want the large size or the small size?", "zh": "您要大号的还是小号的？" },
    { "speaker": "Lady", "en": "The large size, please.", "zh": "请拿大号的。" },
    { "speaker": "Lady", "en": "Do you have any writing paper?", "zh": "您有信纸吗？" },
    { "speaker": "Shop assistant", "en": "Yes, we do.", "zh": "有。" },
    { "speaker": "Shop assistant", "en": "I don't have any small pads.", "zh": "我没有小本的信纸，" },
    { "speaker": "Shop assistant", "en": "I only have large ones.", "zh": "只有大本的。" },
    { "speaker": "Shop assistant", "en": "Do you want a pad?", "zh": "您要一本吗？" },
    { "speaker": "Lady", "en": "Yes, please.", "zh": "好，请拿一本。" },
    { "speaker": "Lady", "en": "And I want some glue.", "zh": "我还要些胶水。" },
    { "speaker": "Shop assistant", "en": "A bottle of glue.", "zh": "一瓶胶水。" },
    { "speaker": "Lady", "en": "And I want a large box of chalk, too.", "zh": "我还要一大盒粉笔。" },
    { "speaker": "Shop assistant", "en": "I only have small boxes.", "zh": "我只有小盒的。" },
    { "speaker": "Shop assistant", "en": "Do you want one?", "zh": "您要一盒吗？" },
    { "speaker": "Lady", "en": "No, thank you.", "zh": "不了，谢谢。" },
    { "speaker": "Shop assistant", "en": "Is that all?", "zh": "就要这些吗？" },
    { "speaker": "Lady", "en": "That's all, thank you.", "zh": "就这些，谢谢。" },
    { "speaker": "Shop assistant", "en": "What else do you want?", "zh": "您还要什么吗？" },
    { "speaker": "Lady", "en": "I want my change.", "zh": "我要找的零钱。" }
  ],
