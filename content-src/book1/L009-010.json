  "lines": [
    { "speaker": "Steven", "en": "Hello, Helen.", "zh": "你好，海伦。" },
    { "speaker": "Helen", "en": "Hi, Steven.", "zh": "你好，史蒂文。" },
    { "speaker": "Steven", "en": "How are you today?", "zh": "你今天好吗？" },
    { "speaker": "Helen", "en": "I'm very well, thank you.", "zh": "很好，谢谢你。" },
    { "speaker": "Helen", "en": "And you?", "zh": "你好吗？" },
    { "speaker": "Steven", "en": "I'm fine, thanks.", "zh": "很好，谢谢。" },
    { "speaker": "Steven", "en": "How is Tony?", "zh": "托尼好吗？" },
    { "speaker": "Helen", "en": "He's fine, thanks.", "zh": "他很好，谢谢。" },
    { "speaker": "Helen", "en": "How's Emma?", "zh": "埃玛好吗？" },
    { "speaker": "Steven", "en": "She's very well, too, Helen.", "zh": "她也很好，海伦。" },
    { "speaker": "Steven", "en": "Goodbye, Helen.", "zh": "再见，海伦。" },
    { "speaker": "Steven", "en": "Nice to see you.", "zh": "见到你真高兴。" },
    { "speaker": "Helen", "en": "Nice to see you, too, Steven.", "zh": "我见到你也很高兴，史蒂文。" },
    { "speaker": "Helen", "en": "Goodbye.", "zh": "再见。" }
