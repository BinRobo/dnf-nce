  "lines": [
    {
      "speaker": "Man",
      "en": "Give me a book please, Jane.",
      "zh": "请拿本书给我，简。"
    },
    {
      "speaker": "Woman",
      "en": "Which book?",
      "zh": "哪一本？"
    },
    {
      "speaker": "Woman",
      "en": "This one?",
      "zh": "是这本吗？"
    },
    {
      "speaker": "Man",
      "en": "No, not that one. The red one.",
      "zh": "不，不是那本。是那本红皮的。"
    },
    {
      "speaker": "Woman",
      "en": "This one?",
      "zh": "这本吗？"
    },
    {
      "speaker": "Man",
      "en": "Yes, please.",
      "zh": "是的，请给我。"
    },
    {
      "speaker": "Woman",
      "en": "Here you are.",
      "zh": "给你。"
    },
    {
      "speaker": "Man",
      "en": "Thank you.",
      "zh": "谢谢。"
    }
  ],
