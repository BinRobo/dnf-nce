 "lines": [
  {
   "speaker": "Helen",
   "en": "Isn't there anyone at home?",
   "zh": "家里没有人吗？"
  },
  {
   "speaker": "Jim",
   "en": "I'll knock again, Helen.",
   "zh": "海伦，我再敲一次。"
  },
  {
   "speaker": "Jim",
   "en": "Everything's very quiet.",
   "zh": "毫无动静。"
  },
  {
   "speaker": "Jim",
   "en": "I'm sure there's no one at home.",
   "zh": "肯定家里没有人。"
  },
  {
   "speaker": "Helen",
   "en": "But that's impossible.",
   "zh": "但这是不可能的。"
  },
  {
   "speaker": "Helen",
   "en": "Carol and Tom invited us to lunch.",
   "zh": "卡罗尔和汤姆请我们来吃午饭。"
  },
  {
   "speaker": "Helen",
   "en": "Look through the window.",
   "zh": "从窗子往里看看。"
  },
  {
   "speaker": "Helen",
   "en": "Can you see anything?",
   "zh": "你能看见什么吗？"
  },
  {
   "speaker": "Jim",
   "en": "Nothing at all.",
   "zh": "什么也看不见。"
  },
  {
   "speaker": "Helen",
   "en": "Let's try the back door.",
   "zh": "让我们到后门去试试。"
  },
  {
   "speaker": "Jim",
   "en": "Look! Everyone's in the garden.",
   "zh": "瞧！大家都在花园里。"
  },
  {
   "speaker": "Carol",
   "en": "Hello, Helen. Hello, Jim.",
   "zh": "你好，海伦。你好，吉姆。"
  },
  {
   "speaker": "Tom",
   "en": "Everybody wants to have lunch in the garden.",
   "zh": "大家都想在花园里吃午饭。"
  },
  {
   "speaker": "Tom",
   "en": "It's nice and warm out here.",
   "zh": "这外面挺暖和。"
  },
  {
   "speaker": "Carol",
   "en": "Come and have something to drink.",
   "zh": "来喝点什么。"
  },
  {
   "speaker": "Jim",
   "en": "Thanks, Carol.",
   "zh": "谢谢，卡罗尔。"
  },
  {
   "speaker": "Jim",
   "en": "May I have a glass of beer please?",
   "zh": "给我一杯啤酒好吗？"
  },
  {
   "speaker": "Carol",
   "en": "Beer?",
   "zh": "啤酒？"
  },
  {
   "speaker": "Carol",
   "en": "There's none left.",
   "zh": "一点都不剩了。"
  },
  {
   "speaker": "Carol",
   "en": "You can have some lemonade.",
   "zh": "你可以喝点柠檬水。"
  },
  {
   "speaker": "Jim",
   "en": "Lemonade!",
   "zh": "柠檬水！"
  },
  {
   "speaker": "Tom",
   "en": "Don't believe her, Jim.",
   "zh": "吉姆，别信她的。"
  },
  {
   "speaker": "Tom",
   "en": "She's only joking.",
   "zh": "她只是在开玩笑。"
  },
  {
   "speaker": "Tom",
   "en": "Have some beer!",
   "zh": "喝点啤酒吧！"
  }
 ],
