  "lines": [
    { "speaker": "Mrs. Johnson", "en": "Hello.", "zh": "您好。" },
    { "speaker": "Mrs. Johnson", "en": "Were you at the butcher's?", "zh": "刚才您在肉店里吗？" },
    { "speaker": "Mrs. Williams", "en": "Yes, I was.", "zh": "是的，我在肉店里。" },
    { "speaker": "Mrs. Williams", "en": "Were you at the butcher's, too?", "zh": "您也在肉店里吗？" },
    { "speaker": "Mrs. Johnson", "en": "No, I wasn't.", "zh": "不，我不是。" },
    { "speaker": "Mrs. Johnson", "en": "I was at the greengrocer's.", "zh": "我在蔬菜水果店里。" },
    { "speaker": "Mrs. Johnson", "en": "How's Jimmy today?", "zh": "吉米今天怎么样？" },
    { "speaker": "Mrs. Williams", "en": "He's very well, thank you.", "zh": "他很好，谢谢您。" },
    { "speaker": "Mrs. Johnson", "en": "Was he absent from school last week?", "zh": "上星期他没上学吧？" },
    { "speaker": "Mrs. Williams", "en": "Yes, he was.", "zh": "是的，他没上学。" },
    { "speaker": "Mrs. Williams", "en": "He was absent on Monday, Tuesday, Wednesday and Thursday.", "zh": "他星期一、星期二、星期三和星期四没去上学。" },
    { "speaker": "Mrs. Williams", "en": "How are you all keeping?", "zh": "你们身体都好吗？" },
    { "speaker": "Mrs. Johnson", "en": "Very well, thank you.", "zh": "很好，谢谢您。" },
    { "speaker": "Mrs. Johnson", "en": "We're going to spend three days in the country.", "zh": "我们打算到乡下去三天。" },
    { "speaker": "Mrs. Johnson", "en": "We're going to stay at my mother's for the weekend.", "zh": "在我母亲家度周末。" },
    { "speaker": "Mrs. Williams", "en": "Friday, Saturday and Sunday in the country!", "zh": "星期五、星期六和星期日在乡下过！" },
    { "speaker": "Mrs. Williams", "en": "Aren't you lucky!", "zh": "你们真幸运啊！" }
  ],
