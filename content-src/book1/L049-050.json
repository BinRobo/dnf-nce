  "lines": [
    {
      "speaker": "Butcher",
      "en": "Do you want any meat today, Mrs. Bird?",
      "zh": "您今天要买点肉吗，伯德夫人？"
    },
    {
      "speaker": "Mrs. Bird",
      "en": "Yes, please.",
      "zh": "是的，我买一点。"
    },
    {
      "speaker": "Butcher",
      "en": "Do you want beef or lamb?",
      "zh": "您要牛肉还是要羔羊肉？"
    },
    {
      "speaker": "Mrs. Bird",
      "en": "Beef, please.",
      "zh": "请给我牛肉。"
    },
    {
      "speaker": "Butcher",
      "en": "This lamb's very good.",
      "zh": "这羔羊肉很好。"
    },
    {
      "speaker": "Mrs. Bird",
      "en": "I like lamb, but my husband doesn't.",
      "zh": "我喜欢羔羊肉，可我丈夫不喜欢。"
    },
    {
      "speaker": "Butcher",
      "en": "What about some steak?",
      "zh": "来点牛排吗？"
    },
    {
      "speaker": "Butcher",
      "en": "This is a nice piece.",
      "zh": "这块很好。"
    },
    {
      "speaker": "Mrs. Bird",
      "en": "Give me that piece, please.",
      "zh": "就请给我那块吧。"
    },
    {
      "speaker": "Mrs. Bird",
      "en": "And a pound of mince, too.",
      "zh": "再来一磅绞肉。"
    },
    {
      "speaker": "Butcher",
      "en": "Do you want a chicken, Mrs. Bird?",
      "zh": "您要买只鸡吗，伯德夫人？"
    },
    {
      "speaker": "Butcher",
      "en": "They're very nice.",
      "zh": "这些鸡很好。"
    },
    {
      "speaker": "Mrs. Bird",
      "en": "No, thank you.",
      "zh": "不要了，谢谢。"
    },
    {
      "speaker": "Mrs. Bird",
      "en": "My husband likes steak, but he doesn't like chicken.",
      "zh": "我丈夫喜欢牛排，但他不喜欢鸡。"
    },
    {
      "speaker": "Butcher",
      "en": "To tell you the truth, Mrs. Bird, I don't like chicken either!",
      "zh": "说老实话，伯德夫人，我也不喜欢鸡。"
    }
  ],
