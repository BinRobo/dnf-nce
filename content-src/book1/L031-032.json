  "lines": [
    {
      "speaker": "Jean",
      "en": "Where's Sally, Jack?",
      "zh": "杰克，萨莉在哪儿？"
    },
    {
      "speaker": "Jack",
      "en": "She's in the garden, Jean.",
      "zh": "她在花园里，琼。"
    },
    {
      "speaker": "Jean",
      "en": "What's she doing?",
      "zh": "她在干什么？"
    },
    {
      "speaker": "Jack",
      "en": "She's sitting under the tree.",
      "zh": "她正在树荫下坐着。"
    },
    {
      "speaker": "Jean",
      "en": "Is Tim in the garden, too?",
      "zh": "蒂姆也在花园里吗？"
    },
    {
      "speaker": "Jack",
      "en": "Yes, he is.",
      "zh": "是的，他也在花园里。"
    },
    {
      "speaker": "Jack",
      "en": "He's climbing the tree.",
      "zh": "他正在爬树。"
    },
    {
      "speaker": "Jean",
      "en": "I beg your pardon?",
      "zh": "你说什么？"
    },
    {
      "speaker": "Jean",
      "en": "Who's climbing the tree?",
      "zh": "谁在爬树？"
    },
    {
      "speaker": "Jack",
      "en": "Tim is.",
      "zh": "蒂姆在爬树。"
    },
    {
      "speaker": "Jean",
      "en": "What about the dog?",
      "zh": "那么狗呢？"
    },
    {
      "speaker": "Jack",
      "en": "The dog's in the garden, too.",
      "zh": "狗也在花园里。"
    },
    {
      "speaker": "Jack",
      "en": "It's running across the grass.",
      "zh": "它正在草地上跑，"
    },
    {
      "speaker": "Jack",
      "en": "It's running after a cat.",
      "zh": "在追一只猫。"
    }
  ],
