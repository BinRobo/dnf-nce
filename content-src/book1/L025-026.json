  "lines": [
    { "en": "Mrs. Smith's kitchen is small.", "zh": "史密斯夫人的厨房很小。" },
    { "en": "There is a refrigerator in the kitchen.", "zh": "厨房里有个电冰箱。" },
    { "en": "The refrigerator is white.", "zh": "冰箱的颜色是白的。" },
    { "en": "It is on the right.", "zh": "它位于房间右侧。" },
    { "en": "There is an electric cooker in the kitchen.", "zh": "厨房里有个电灶。" },
    { "en": "The cooker is blue.", "zh": "电灶的颜色是蓝的。" },
    { "en": "It is on the left.", "zh": "它位于房间左侧。" },
    { "en": "There is a table in the middle of the room.", "zh": "房间的中央有张桌子。" },
    { "en": "There is a bottle on the table.", "zh": "桌子上有个瓶子。" },
    { "en": "The bottle is empty.", "zh": "瓶子是空的。" },
    { "en": "There is a cup on the table, too.", "zh": "桌子上还有一只杯子。" },
    { "en": "The cup is clean.", "zh": "杯子很干净。" }
  ],
  "drills": [
