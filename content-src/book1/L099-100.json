 "lines": [
  {
   "speaker": "Andy",
   "en": "Ow!",
   "zh": "啊哟！"
  },
  {
   "speaker": "Lucy",
   "en": "What's the matter, Andy?",
   "zh": "怎么了，安迪？"
  },
  {
   "speaker": "Andy",
   "en": "I slipped and fell downstairs.",
   "zh": "我滑了一跤，从楼梯上摔下来了。"
  },
  {
   "speaker": "Lucy",
   "en": "Have you hurt yourself?",
   "zh": "你摔伤了没有？"
  },
  {
   "speaker": "Andy",
   "en": "Yes, I have.",
   "zh": "是啊，摔伤了。"
  },
  {
   "speaker": "Andy",
   "en": "I think that I've hurt my back.",
   "zh": "我想我把背摔坏了。"
  },
  {
   "speaker": "Lucy",
   "en": "Try and stand up.",
   "zh": "试试站起来。"
  },
  {
   "speaker": "Lucy",
   "en": "Can you stand up?",
   "zh": "你能站起来吗？"
  },
  {
   "speaker": "Lucy",
   "en": "Here. Let me help you.",
   "zh": "来，让我帮你。"
  },
  {
   "speaker": "Andy",
   "en": "I'm sorry, Lucy.",
   "zh": "对不起，露西。"
  },
  {
   "speaker": "Andy",
   "en": "I'm afraid that I can't get up.",
   "zh": "恐怕我站不起来。"
  },
  {
   "speaker": "Lucy",
   "en": "I think that the doctor had better see you.",
   "zh": "我想最好请医生来给你看一下。"
  },
  {
   "speaker": "Lucy",
   "en": "I'll phone Dr. Carter.",
   "zh": "我去给卡特医生打电话。"
  },
  {
   "speaker": "Lucy",
   "en": "The doctor says that he will come at once.",
   "zh": "医生说他马上就来。"
  },
  {
   "speaker": "Lucy",
   "en": "I'm sure that you need an X-ray, Andy.",
   "zh": "安迪，我看你需要做一次 X 光透视。"
  }
 ],
