  "lines": [
    {
      "speaker": "Louise",
      "en": "What colour's your new dress?",
      "zh": "你的新连衣裙是什么颜色的？"
    },
    {
      "speaker": "Anna",
      "en": "It's green.",
      "zh": "是绿色的。"
    },
    {
      "speaker": "Anna",
      "en": "Come upstairs and see it.",
      "zh": "到楼上来看看吧。"
    },
    {
      "speaker": "Louise",
      "en": "Thank you.",
      "zh": "谢谢。"
    },
    {
      "speaker": "Anna",
      "en": "Look!",
      "zh": "瞧，"
    },
    {
      "speaker": "Anna",
      "en": "Here it is!",
      "zh": "就是这件。"
    },
    {
      "speaker": "Louise",
      "en": "That's a nice dress.",
      "zh": "这件连衣裙真好，"
    },
    {
      "speaker": "Louise",
      "en": "It's very smart.",
      "zh": "真漂亮。"
    },
    {
      "speaker": "Anna",
      "en": "My hat's new, too.",
      "zh": "我的帽子也是新的。"
    },
    {
      "speaker": "Louise",
      "en": "What colour is it?",
      "zh": "是什么颜色的？"
    },
    {
      "speaker": "Anna",
      "en": "It's the same colour.",
      "zh": "一样的颜色，"
    },
    {
      "speaker": "Anna",
      "en": "It's green, too.",
      "zh": "也是绿的。"
    },
    {
      "speaker": "Louise",
      "en": "That is a lovely hat!",
      "zh": "真是一顶可爱的帽子！"
    }
  ],
